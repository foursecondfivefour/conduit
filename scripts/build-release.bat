@echo off
cd /d "%~dp0.."
echo Running go mod tidy...
go mod tidy
echo Running go vet...
go vet ./...
echo Building conduit.exe...
go build -trimpath -ldflags="-s -w -H windowsgui" -o build/conduit.exe .
echo Building updater...
go build -trimpath -ldflags="-s -w" -o build/conduit-updater.exe .\cmd\updater 2>nul || echo updater not found, skipping
echo Done!
